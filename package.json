{
  "name": "simple-html-playwright-suite",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright UI/UX test suite for the Simple HTML App",
  "scripts": {
    "start:local": "node mock-api.js",
    "start:safe": "bash scripts/serve-safe.sh",
    "ai:generate-tests": "node scripts/ai-generate-tests.js",
    "ai:pipeline": "node scripts/ai-pipeline.js",
    "ai:latest": "bash scripts/latest-ai-report.sh",
    "ai:ollama:pull": "ollama pull qwen2.5-coder:7b",
    "pipeline:local": "node scripts/local-pipeline.js",
    "pipeline:latest": "bash scripts/latest-pipeline-report.sh",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:update-snapshots": "playwright test tests/visual --update-snapshots",
    "playwright:install": "playwright install chromium"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.5.0",
    "http-server": "^14.1.1"
  }
}
